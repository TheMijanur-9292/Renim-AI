# Renim AI — Production Environment Template
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# REQUIRED: random string, 32+ chars. Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
PORT=3057
# Keep false in production: all anonymous visitors would share one account.
ALLOW_GUEST_MODE=false
APP_BASE_URL=https://app.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
# Set true only when running behind a trusted reverse proxy (Vercel/Nginx) so rate limits use X-Forwarded-For.
TRUST_PROXY=false

# Super Admin bootstrap (account is created on first boot; password is never overwritten afterwards)
SUPERADMIN_EMAIL=
# 12+ characters
SUPERADMIN_PASSWORD=

# AI Gateway
AIM_BASE_URL=https://2c-aim-api.2coms.com
AIM_API_KEY=your-aim-api-key
AIM_MODEL=qwen2.5
AI_MAX_TOKENS_CAP=4000

# Optional: real audio transcription with speaker labels (Speaker A/B...) via AssemblyAI.
# Supports English, Bangla (bn) and Hindi (hi). Leave empty to keep the built-in fallback.
ASSEMBLYAI_API_KEY=

# Razorpay Billing (India - INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe Billing (Optional). The webhook rejects all events unless STRIPE_WEBHOOK_SECRET is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (password resets need this in production)
RESEND_API_KEY=
EMAIL_FROM=Renim AI <no-reply@yourdomain.com>

# Local development only — NEVER enable in production
# ALLOW_EPHEMERAL_JWT_SECRET=true
# DEV_RETURN_RESET_TOKEN=true

# ---------------------------------------------------------------------------
# Calendar sync (Google Calendar / Microsoft Outlook) — read-only, optional.
# Leave blank and the Calendars section shows "Not configured yet".
# Public base URL where the backend is reachable (no trailing slash). Register these redirect URIs:
#   {OAUTH_REDIRECT_BASE}/api/calendar-sync/google/callback
#   {OAUTH_REDIRECT_BASE}/api/calendar-sync/microsoft/callback
OAUTH_REDIRECT_BASE=
# Optional: where the browser is sent after connecting (defaults to OAUTH_REDIRECT_BASE). Lands on {FRONTEND_URL}/app
FRONTEND_URL=
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application). Enable "Google Calendar API".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Azure portal > Microsoft Entra ID > App registrations. Delegated Graph permissions: Calendars.Read, User.Read, offline_access.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" (any work/school or personal account), "organizations", "consumers", or your tenant ID.
MS_TENANT=common
# Encrypts stored calendar tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_KEY=

# --- Error monitoring (optional; leave empty to disable) ---
# Backend Sentry DSN (from sentry.io > Project Settings > Client Keys)
SENTRY_DSN=
# Fraction of requests traced for performance (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Environment tag shown in Sentry (production, staging, development)
APP_ENV=production
# Frontend (browser) Sentry DSN — baked in at build time by Astro; set it in your frontend host (e.g. Vercel)
PUBLIC_SENTRY_DSN=
