---
import SentryLoader from '../components/SentryLoader.astro';
/**
 * Renim AI — Sign in (redesign). Responsive: photo panel hides below 960px.
 */
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in — Renim AI</title>
  <meta name="description" content="Sign in to Renim AI to pick up where you left off — your briefing, conversations, notes and follow-ups.">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <meta name="theme-color" content="#0891b2">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..600,0..1,0" />
  <style is:global>
    *,*::before,*::after{box-sizing:border-box}
    [hidden]{display:none !important}
    html,body{height:100%;overflow:hidden}
    body{margin:0;background:#fbfcfd;color:#0f172a;font-family:'Plus Jakarta Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:#0e7490;text-decoration:none}a:hover{color:#155e75}
    .ms{font-family:'Material Symbols Rounded';font-weight:normal;font-style:normal;font-size:20px;line-height:1;display:inline-block;white-space:nowrap;font-feature-settings:'liga';-webkit-font-feature-settings:'liga';font-variation-settings:'FILL' 0,'wght' 400,'opsz' 24;user-select:none}
    .ms.fill{font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24}
    .shell{height:100vh;height:100dvh;display:flex;overflow:hidden}
    .form-side{position:relative;flex:1 1 560px;min-width:0;display:flex;flex-direction:column;overflow:hidden}
    .aur{position:absolute;left:0;right:0;top:0;height:520px;filter:blur(70px);opacity:.7;pointer-events:none}
    .blob{position:absolute;border-radius:50%;mix-blend-mode:multiply}
    .b1{width:420px;height:340px;left:-60px;top:-100px;background:#a5f3fc;animation:a1 16s ease-in-out infinite}
    .b2{width:380px;height:320px;right:-40px;top:-40px;background:#c7d2fe;animation:a2 19s ease-in-out infinite}
    .b3{width:320px;height:260px;left:30%;top:160px;background:#ddd6fe;animation:a1 23s ease-in-out infinite reverse}
    @keyframes a1{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(120px,50px) scale(1.15)}66%{transform:translate(40px,-30px) scale(.9)}}
    @keyframes a2{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(-140px,60px) scale(.9)}66%{transform:translate(-40px,-20px) scale(1.12)}}
    .fade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(251,252,253,0),rgba(251,252,253,.4) 40%,#fbfcfd 80%);pointer-events:none}
    .top{position:relative;display:flex;justify-content:space-between;align-items:center;padding:12px clamp(16px,4vw,48px);gap:12px}
    .brand{display:flex;align-items:center;gap:10px;color:#0f172a;font-weight:800;font-size:18px;letter-spacing:-.02em}
    .brand img{width:30px;height:30px;border-radius:9px}
    .brand b{color:#0e7490}
    .home{display:inline-flex;align-items:center;gap:6px;font-size:13.5px;font-weight:600;color:#475569;min-height:32px}
    .center{position:relative;flex:1;display:flex;align-items:center;justify-content:center;padding:4px clamp(16px,4vw,48px) 12px}
    .box{width:100%;max-width:400px}
    .view{display:none}.view.on{display:block}
    .h{margin:0;font-size:clamp(24px,2.5vw,30px);letter-spacing:-.03em;line-height:1.12}
    .p{margin:6px 0 16px;color:#475569;font-size:14px;line-height:1.45}
    form{display:flex;flex-direction:column;gap:12px}
    .field{display:flex;flex-direction:column;gap:5px}
    .field label{font-size:13px;font-weight:600}
    .iw{position:relative}
    .iw > .ms{position:absolute;left:13px;top:11.5px;font-size:19px;color:#64748b;pointer-events:none}
    .inp{width:100%;height:42px;border-radius:10px;border:1px solid #d5dde5;background:#fff;padding:0 12px 0 38px;font-family:inherit;font-size:14.5px;color:#0f172a;outline:none;transition:border-color .15s,box-shadow .15s}
    .inp:focus{border-color:#0891b2;box-shadow:0 0 0 4px rgba(8,145,178,.15)}
    .inp::placeholder{color:#94a3b8}
    .eye{position:absolute;right:2px;top:2px;width:38px;height:38px;border:0;background:none;cursor:pointer;color:#64748b;display:flex;align-items:center;justify-content:center;border-radius:8px}
    .btn-main{width:100%;height:44px;border:0;border-radius:10px;background:#0f172a;color:#fff;font-family:inherit;font-size:14.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:background .15s,opacity .15s;margin-top:2px}
    .btn-main:hover{background:#1e293b}.btn-main:disabled{opacity:.6;cursor:wait}
    .ghost{background:none;border:0;padding:0;font-family:inherit;cursor:pointer;color:#0e7490;font-weight:600;font-size:13px;min-height:24px}
    .ghost:hover{color:#155e75}
    .otp{padding:10px;border-radius:10px;background:#ecfeff;border:1px solid #cdeef4}
    .otp .inp{padding-left:14px;letter-spacing:.3em;font-weight:700}
    .alert{display:none;margin-bottom:12px;padding:9px 12px;border-radius:10px;font-size:13px;line-height:1.4}
    .alert.show{display:flex;gap:8px;align-items:flex-start}
    .alert.error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
    .alert.success{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
    .alert.info{background:#ecfeff;color:#155e75;border:1px solid #cdeef4}
    .sso{display:none;font-size:13px;color:#155e75;font-weight:600;align-items:center;gap:6px}
    .note{margin-top:16px;padding-top:12px;border-top:1px solid #e9eef3;display:flex;gap:8px;align-items:flex-start;font-size:12px;color:#64748b;line-height:1.4}
    .photo{position:relative;flex:1 1 560px;min-width:0;margin:12px;border-radius:24px;overflow:hidden;background:#0f172a;min-height:0}
    .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    @keyframes kb{0%{transform:scale(1)}100%{transform:scale(1.08)}}
    .kb{animation:kb 16s ease-in-out infinite alternate}
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    .float{animation:float 6s ease-in-out infinite}.d2{animation-delay:-2s}
    @keyframes cycle{0%{opacity:0;transform:translateY(8px)}4%,20%{opacity:1;transform:translateY(0)}24%,100%{opacity:0;transform:translateY(-8px)}}
    .uc{position:absolute;left:0;top:0;opacity:0;animation:cycle 15s ease-in-out infinite;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:rgba(255,255,255,.14);color:#fff;font-weight:600}
    .uc .ms{font-size:16px;color:#67e8f9}
    .u2{animation-delay:3s}.u3{animation-delay:6s}.u4{animation-delay:9s}.u5{animation-delay:12s}
    @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.5)}100%{box-shadow:0 0 0 8px rgba(16,185,129,0)}}
    .live{width:8px;height:8px;border-radius:50%;background:#10b981;flex:none;animation:pulse 1.6s ease-out infinite}
    .brief{position:absolute;right:36px;top:40px;width:300px;max-width:calc(100% - 72px);background:rgba(255,255,255,.96);border-radius:18px;padding:18px;box-shadow:0 30px 60px -24px rgba(15,23,42,.45);display:flex;flex-direction:column;gap:12px}
    .brief .r{display:flex;align-items:center;gap:10px;font-size:13px;color:#334155}
    .brief .i{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center}
    @media (max-width:960px){.photo{display:none}}
    @media (max-width:520px){.top{padding:16px}.p{font-size:15px}}
    @media (prefers-reduced-motion:reduce){*{animation:none !important}.u1{opacity:1}}
  </style>
  <SentryLoader />
</head>
<body>
<div class="shell">
  <main class="form-side">
    <div class="aur" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span></div>
    <div class="fade" aria-hidden="true"></div>

    <div class="top">
      <a href="/" class="brand"><img src="/icon.svg" alt="" width="34" height="34" /><span>Renim <b>AI</b></span></a>
      <a href="/" class="home"><span class="ms" style="font-size:18px" aria-hidden="true">arrow_back</span>Home</a>
    </div>

    <div class="center">
      <div class="box">
        <div id="signin-alert" class="alert" role="status" aria-live="polite"></div>

        <!-- Sign in -->
        <section class="view on" id="view-signin">
          <h1 class="h">Welcome back</h1>
          <p class="p">Sign in to pick up where you left off — your briefing, conversations, notes and follow-ups are waiting.</p>
          <form id="signin-form" novalidate>
            <div class="field">
              <label for="signin-email">Email</label>
              <div class="iw"><span class="ms" aria-hidden="true">mail</span><input type="email" id="signin-email" class="inp" placeholder="name@example.com" autocomplete="email" required /></div>
            </div>
            <div class="field">
              <div style="display:flex;justify-content:space-between;align-items:center"><label for="signin-password">Password</label><button type="button" class="ghost" data-go="forgot">Forgot password?</button></div>
              <div class="iw"><span class="ms" aria-hidden="true">lock</span><input type="password" id="signin-password" class="inp" placeholder="Your password" autocomplete="current-password" style="padding-right:52px" required /><button type="button" class="eye" data-eye="signin-password" aria-label="Show password"><span class="ms" aria-hidden="true">visibility</span></button></div>
            </div>
            <div class="field otp" id="totp-field" hidden>
              <label for="signin-totp">Verification code</label>
              <span style="font-size:13px;color:#155e75">Enter the 6-digit code from your authenticator app.</span>
              <input type="text" id="signin-totp" class="inp" placeholder="123456" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
            </div>
            <button type="submit" id="signin-btn" class="btn-main"><span id="signin-btn-text">Sign in</span><span class="ms" aria-hidden="true">arrow_forward</span></button>
          </form>
          <p style="margin:14px 0 0;text-align:center;font-size:13px;color:#475569">New to Renim AI? <a href="/signup" style="font-weight:700">Create a free account</a></p>
          <p style="margin:6px 0 0;text-align:center;font-size:12px;color:#64748b"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
        </section>

        <!-- Forgot -->
        <section class="view" id="view-forgot">
          <button type="button" class="ghost" data-go="signin" style="display:inline-flex;align-items:center;gap:6px;margin-bottom:20px;color:#475569"><span class="ms" style="font-size:18px" aria-hidden="true">arrow_back</span>Back to sign in</button>
          <h1 class="h">Reset your password</h1>
          <p class="p">Enter the email you use for Renim AI and we'll send you a secure link to choose a new password.</p>
          <form id="forgot-form" novalidate>
            <div class="field">
              <label for="forgot-email">Email</label>
              <div class="iw"><span class="ms" aria-hidden="true">mail</span><input type="email" id="forgot-email" class="inp" placeholder="name@example.com" autocomplete="email" required /></div>
            </div>
            <button type="submit" id="forgot-send-btn" class="btn-main">Send reset link</button>
          </form>
        </section>

        <!-- Sent -->
        <section class="view" id="view-sent">
          <span style="width:56px;height:56px;border-radius:16px;background:#ecfdf5;display:flex;align-items:center;justify-content:center;margin-bottom:14px"><span class="ms fill" style="font-size:30px;color:#059669" aria-hidden="true">mark_email_read</span></span>
          <h1 class="h">Check your inbox</h1>
          <p class="p">If an account exists for that email, a reset link is on its way. The link works once and expires soon, so use it shortly.</p>
          <button type="button" class="btn-main" data-go="signin">Back to sign in</button>
          <p style="margin:14px 0 0;font-size:13px;color:#64748b">Didn't get it? Check spam, or <button type="button" class="ghost" data-go="forgot" style="font-size:13px">try again</button>.</p>
        </section>

        <!-- Reset (from email link) -->
        <section class="view" id="view-reset">
          <h1 class="h">Choose a new password</h1>
          <p class="p">Use at least 8 characters with a mix of letters and numbers.</p>
          <form id="reset-form" novalidate>
            <input type="hidden" id="reset-token-input" />
            <div class="field">
              <label for="reset-pass-input">New password</label>
              <div class="iw"><span class="ms" aria-hidden="true">lock_reset</span><input type="password" id="reset-pass-input" class="inp" placeholder="New password" autocomplete="new-password" style="padding-right:52px" required /><button type="button" class="eye" data-eye="reset-pass-input" aria-label="Show password"><span class="ms" aria-hidden="true">visibility</span></button></div>
            </div>
            <button type="submit" id="reset-confirm-btn" class="btn-main">Update password</button>
          </form>
        </section>

        <div class="note">
          <span class="ms" style="font-size:18px;color:#0e7490" aria-hidden="true">shield_lock</span>
          <span>Your workspace is private to you and your team. Turn on two-factor authentication anytime in Settings.</span>
        </div>
      </div>
    </div>
  </main>

  <aside class="photo" aria-hidden="true">
    <img class="kb" src="/images/calm-desk.jpg" alt="" />
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,23,42,.05) 0%,rgba(15,23,42,.15) 45%,rgba(15,23,42,.82) 100%)"></div>
    <div class="float d2" style="position:absolute;left:36px;top:46%;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:14px;background:rgba(15,23,42,.9);color:#fff;font-size:13px;box-shadow:0 20px 40px -16px rgba(0,0,0,.5)"><span class="live"></span>Conversation summarized · 4 action items</div>
    <div style="position:absolute;left:0;right:0;bottom:0;padding:28px 32px;color:#fff;display:flex;flex-direction:column;gap:10px">
      <h2 style="margin:0;font-size:clamp(20px,2vw,26px);letter-spacing:-.02em;line-height:1.2;max-width:500px">One calm place for everything your work asks you to remember.</h2>
      <div style="display:flex;align-items:center;gap:10px;font-size:15px;color:#cbd5e1;flex-wrap:wrap">
        <span>Built for</span>
        <span style="position:relative;display:inline-block;height:28px;min-width:220px">
          <span class="uc u1"><span class="ms">call</span>client calls</span>
          <span class="uc u2"><span class="ms">groups</span>team meetings</span>
          <span class="uc u3"><span class="ms">school</span>lectures &amp; classes</span>
          <span class="uc u4"><span class="ms">badge</span>interviews</span>
          <span class="uc u5"><span class="ms">handshake</span>consultations</span>
        </span>
      </div>
    </div>
  </aside>
</div>

<script is:inline>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var alertBox = $('signin-alert');
    var views = ['signin', 'forgot', 'sent', 'reset'];

    function show(name) {
      views.forEach(function (v) { $('view-' + v).classList.toggle('on', v === name); });
      clearAlert();
      var first = $('view-' + name).querySelector('input:not([type=hidden])');
      if (first) setTimeout(function () { first.focus(); }, 30);
    }
    function setAlert(kind, msg) {
      alertBox.className = 'alert show ' + kind;
      var icon = kind === 'error' ? 'error' : kind === 'success' ? 'check_circle' : 'info';
      alertBox.innerHTML = '';
      var i = document.createElement('span'); i.className = 'ms'; i.style.fontSize = '18px'; i.textContent = icon;
      var t = document.createElement('span'); t.textContent = msg;
      alertBox.appendChild(i); alertBox.appendChild(t);
    }
    function clearAlert() { alertBox.className = 'alert'; alertBox.textContent = ''; }

    document.querySelectorAll('[data-go]').forEach(function (b) {
      b.addEventListener('click', function () {
        var to = b.getAttribute('data-go');
        if (to === 'forgot') { var em = $('signin-email').value.trim(); if (em) $('forgot-email').value = em; }
        show(to);
      });
    });
    document.querySelectorAll('[data-eye]').forEach(function (b) {
      b.addEventListener('click', function () {
        var inp = $(b.getAttribute('data-eye'));
        var showing = inp.type === 'text';
        inp.type = showing ? 'password' : 'text';
        b.querySelector('.ms').textContent = showing ? 'visibility' : 'visibility_off';
        b.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
      });
    });

    // Sign in
    var submitBtn = $('signin-btn'), btnText = $('signin-btn-text');
    var emailInput = $('signin-email');
    var totpField = $('totp-field'), totpInput = $('signin-totp');
    $('signin-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      clearAlert();
      var email = emailInput.value.trim();
      var password = $('signin-password').value;
      var totp_code = totpInput.value.trim();
      if (!email || !password) { setAlert('error', 'Enter your email and password to continue.'); return; }
      submitBtn.disabled = true; btnText.textContent = 'Signing in…';
      try {
        var res = await fetch('/api/auth/signin', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, password: password, totp_code: totp_code || undefined })
        });
        var data = await res.json();
        if (!res.ok) throw new Error(data.error || 'We couldn’t sign you in. Check your details and try again.');
        if (data.requires_2fa) {
          totpField.hidden = false; totpInput.focus();
          setAlert('info', data.message || 'Enter the 6-digit code from your authenticator app.');
          submitBtn.disabled = false; btnText.textContent = 'Verify and sign in';
          return;
        }
        localStorage.setItem('sb_session', JSON.stringify({ access_token: data.access_token || '', user: data.user }));
        setAlert('success', 'Signed in. Opening your workspace…');
        setTimeout(function () { window.location.href = '/app'; }, 400);
      } catch (err) {
        setAlert('error', err.message || 'Sign in failed. Please try again.');
        submitBtn.disabled = false; btnText.textContent = totpField.hidden ? 'Sign in' : 'Verify and sign in';
      }
    });

    // Forgot password
    $('forgot-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      var em = $('forgot-email').value.trim();
      if (!em) { setAlert('error', 'Enter the email linked to your account.'); return; }
      var btn = $('forgot-send-btn'); btn.disabled = true;
      try {
        var r = await fetch('/api/auth/forgot-password', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: em })
        });
        var d = await r.json();
        if (!r.ok) throw new Error(d.error || 'We couldn’t send the reset link. Please try again.');
        if (d.reset_token) {               // dev mode only (DEV_RETURN_RESET_TOKEN)
          $('reset-token-input').value = d.reset_token;
          show('reset');
        } else {
          show('sent');
        }
      } catch (err) {
        setAlert('error', err.message);
      } finally { btn.disabled = false; }
    });

    // Reset password (from email link /signin?reset_token=...)
    try {
      var urlToken = new URLSearchParams(window.location.search).get('reset_token');
      if (urlToken) {
        $('reset-token-input').value = urlToken;
        window.history.replaceState({}, '', window.location.pathname);
        show('reset');
      }
    } catch (e) {}

    $('reset-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      var token = $('reset-token-input').value.trim();
      var new_password = $('reset-pass-input').value;
      if (!token) { setAlert('error', 'This reset link is missing or expired. Request a new one.'); return; }
      var btn = $('reset-confirm-btn'); btn.disabled = true;
      try {
        var r = await fetch('/api/auth/reset-password', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token: token, new_password: new_password })
        });
        var d = await r.json();
        if (!r.ok) throw new Error(d.error || 'We couldn’t update your password.');
        show('signin');
        setAlert('success', 'Password updated. Sign in with your new password.');
      } catch (err) {
        setAlert('error', err.message);
      } finally { btn.disabled = false; }
    });
  })();
</script>
</body>
</html>
