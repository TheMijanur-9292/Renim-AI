---
/**
 * Renim AI — Dedicated Sign In Page (/signin)
 */
---
<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In — Renim AI Workspace</title>
  <link rel="icon" type="image/svg+xml" href="/icon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="/style.css" />
  <style>
    .auth-page-shell {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      background: #f8fafc;
      position: relative;
      overflow: hidden;
    }

    @media (max-width: 960px) {
      .auth-page-shell {
        grid-template-columns: 1fr;
      }
      .auth-showcase-side {
        display: none !important;
      }
    }

    /* Left Showcase Column */
    .auth-showcase-side {
      background: #0f172a;
      color: #ffffff;
      padding: 56px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      border-right: 1px solid #1e293b;
    }

    .auth-showcase-side::before {
      display: none;
    }

    .auth-brand-top {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #ffffff;
      z-index: 2;
    }

    .auth-brand-logo {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: #4f46e5;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
    }

    .auth-hero-copy {
      max-width: 500px;
      z-index: 2;
    }

    .auth-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(8, 145, 178, 0.2);
      border: 1px solid rgba(6, 182, 212, 0.35);
      color: #a5f3fc;
      font-size: 12.5px;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .auth-hero-copy h1 {
      font-size: 38px;
      font-weight: 800;
      line-height: 1.18;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }

    .auth-hero-copy p {
      font-size: 15.5px;
      color: #a1a1aa;
      line-height: 1.65;
      margin-bottom: 28px;
    }

    .auth-feature-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .auth-feature-item {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      color: #e4e4e7;
      font-weight: 500;
    }

    .auth-feature-item .material-symbols-rounded {
      color: #06b6d4;
      font-size: 20px;
    }

    /* Right Form Column */
    .auth-form-side {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 40px 24px;
      position: relative;
    }

    .auth-card {
      width: 100%;
      max-width: 440px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 40px 36px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.06);
    }

    .auth-card-header {
      margin-bottom: 28px;
    }

    .auth-card-header h2 {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 6px;
      letter-spacing: -0.02em;
    }

    .auth-card-header p {
      font-size: 14px;
      color: #64748b;
    }

    .auth-field {
      margin-bottom: 18px;
    }

    .auth-field label {
      display: block;
      font-size: 12.5px;
      font-weight: 700;
      color: #334155;
      margin-bottom: 7px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .auth-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .auth-input-wrap .material-symbols-rounded {
      position: absolute;
      left: 14px;
      color: #94a3b8;
      font-size: 19px;
      pointer-events: none;
    }

    .auth-input {
      width: 100%;
      padding: 12px 14px 12px 42px;
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      font-size: 14px;
      color: #0f172a;
      font-family: inherit;
      outline: none;
      transition: all 0.15s ease;
    }

    .auth-input:focus {
      background: #ffffff;
      border-color: #06b6d4;
      box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.15);
    }

    .auth-submit-btn {
      width: 100%;
      padding: 13px 20px;
      border-radius: 10px;
      border: none;
      background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
      color: #ffffff;
      font-size: 14.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 10px 25px rgba(8, 145, 178, 0.35);
      transition: all 0.2s ease;
      margin-top: 6px;
    }

    .auth-submit-btn:hover {
      background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
      transform: translateY(-1px);
    }

    .auth-submit-btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .auth-alert {
      display: none;
      padding: 11px 14px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 16px;
    }

    .auth-alert.error {
      display: block;
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #dc2626;
    }

    .auth-alert.success {
      display: block;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #16a34a;
    }

    .auth-switch-footer {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #e2e8f0;
      text-align: center;
      font-size: 13.5px;
      color: #475569;
    }

    .auth-switch-footer a {
      color: #0891b2;
      font-weight: 700;
      text-decoration: none;
    }

    .auth-switch-footer a:hover {
      text-decoration: underline;
    }

    .back-home-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 20px;
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
      text-decoration: none;
    }

    .back-home-link:hover {
      color: #0891b2;
    }
  </style>
</head>
<body>
  <div class="auth-page-shell">
    <!-- Left Showcase Panel -->
    <aside class="auth-showcase-side">
      <a href="/" class="auth-brand-top">
        <div class="auth-brand-logo" style="overflow: hidden; padding: 0;">
          <img src="/icon.svg" alt="Renim AI" style="width: 100%; height: 100%; object-fit: contain; display: block;" />
        </div>
        <span style="font-size: 20px; font-weight: 800;">Renim AI</span>
        <span class="badge-pro">PRO</span>
      </a>

      <div class="auth-hero-copy">
        <div class="auth-pill">
          <span class="material-symbols-rounded" style="font-size: 16px;">verified_user</span>
          <span>Neon Cloud Sync + AI Second Brain</span>
        </div>
        <h1>Welcome Back to Your Intelligent Workspace.</h1>
        <p>
          Sign in to access your personalized Morning AI Briefings, Smart Notes, Live Meeting Transcripts, Calendar Alerts, and saved Copilot Chat Sessions.
        </p>

        <div class="auth-feature-list">
          <div class="auth-feature-item">
            <span class="material-symbols-rounded">check_circle</span>
            <span>Per-User & Per-Session AI Copilot Chat Memory</span>
          </div>
          <div class="auth-feature-item">
            <span class="material-symbols-rounded">check_circle</span>
            <span>Rich-Text Smart Notes & Live Audio Meeting Hub</span>
          </div>
          <div class="auth-feature-item">
            <span class="material-symbols-rounded">check_circle</span>
            <span>Real-Time Neon PostgreSQL Cloud Persistence</span>
          </div>
        </div>
      </div>

      <div style="font-size: 12.5px; color: #71717a; z-index: 2;">
        © 2026 Renim AI Workspace. Powered by FastAPI, Neon & Qwen 2.5.
      </div>
    </aside>

    <!-- Right Sign In Form Panel -->
    <main class="auth-form-side">
      <div style="width: 100%; max-width: 440px;">
        <a href="/" class="back-home-link">
          <span class="material-symbols-rounded" style="font-size: 18px;">arrow_back</span>
          <span>Back to Homepage</span>
        </a>

        <div class="auth-card">
          <div class="auth-card-header">
            <h2>Sign In to Renim AI</h2>
            <p>Enter your registered email and password to launch your workspace.</p>
          </div>

          <div id="signin-alert" class="auth-alert"></div>

          <form id="signin-form">
            <div class="auth-field">
              <label for="signin-email">Email Address</label>
              <div class="auth-input-wrap">
                <span class="material-symbols-rounded">mail</span>
                <input
                  type="email"
                  id="signin-email"
                  class="auth-input"
                  placeholder="you@company.com"
                  required
                />
              </div>
            </div>

            <div class="auth-field">
              <label for="signin-password">Password</label>
              <div class="auth-input-wrap">
                <span class="material-symbols-rounded">lock</span>
                <input
                  type="password"
                  id="signin-password"
                  class="auth-input"
                  placeholder="••••••••"
                  required
                />
              </div>
            </div>

            <div class="auth-field" id="totp-field" style="display: none;">
              <label for="signin-totp">2FA Authenticator Code (6 digits)</label>
              <div class="auth-input-wrap">
                <span class="material-symbols-rounded">verified_user</span>
                <input
                  type="text"
                  id="signin-totp"
                  class="auth-input"
                  placeholder="123456"
                  maxlength="6"
                  inputmode="numeric"
                />
              </div>
            </div>

            <div id="sso-hint" style="display:none; font-size:12px; color:#0891b2; margin-bottom:12px; font-weight:600;"></div>

            <button type="submit" id="signin-btn" class="auth-submit-btn">
              <span class="material-symbols-rounded" style="font-size: 19px;">login</span>
              <span id="signin-btn-text">Sign In to Workspace</span>
            </button>
          </form>

          <div class="auth-switch-footer" style="display:flex; flex-direction:column; gap:8px;">
            <div>
              <a href="#" id="forgot-password-link" style="font-size:12.5px;">Forgot your password?</a>
            </div>
            <div>
              Don't have a Renim AI account yet?
              <a href="/signup">Create a Free Account →</a>
            </div>
          </div>

          <div id="forgot-box" style="display:none; margin-top:16px; padding-top:16px; border-top:1px solid #e2e8f0;">
            <div style="font-size:13px; font-weight:700; color:#0f172a; margin-bottom:8px;">Reset Password</div>
            <div style="display:flex; gap:8px; margin-bottom:8px;">
              <input type="email" id="forgot-email" class="auth-input" style="padding-left:12px;" placeholder="Enter your account email" />
              <button type="button" id="forgot-send-btn" class="auth-submit-btn" style="width:auto; padding:0 14px; font-size:12.5px;">Send</button>
            </div>
            <div id="reset-fields" style="display:none; flex-direction:column; gap:8px;">
              <input type="text" id="reset-token-input" class="auth-input" style="padding-left:12px;" placeholder="Paste reset token" />
              <input type="password" id="reset-pass-input" class="auth-input" style="padding-left:12px;" placeholder="New password (min 8 chars, letters + numbers)" />
              <button type="button" id="reset-confirm-btn" class="auth-submit-btn" style="font-size:13px;">Update Password</button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script is:inline>
    const form = document.getElementById('signin-form');
    const alertBox = document.getElementById('signin-alert');
    const submitBtn = document.getElementById('signin-btn');
    const btnText = document.getElementById('signin-btn-text');
    const emailInput = document.getElementById('signin-email');
    const totpField = document.getElementById('totp-field');
    const totpInput = document.getElementById('signin-totp');
    const ssoHint = document.getElementById('sso-hint');

    emailInput.addEventListener('blur', async () => {
      const em = emailInput.value.trim();
      if (!em.includes('@')) { ssoHint.style.display = 'none'; return; }
      try {
        const r = await fetch(`/api/auth/sso/check?email=${encodeURIComponent(em)}`);
        const d = await r.json();
        if (d.sso_required) {
          ssoHint.style.display = 'block';
          ssoHint.textContent = `Enterprise SSO & MFA Policy active for @${d.sso_domain}`;
        } else {
          ssoHint.style.display = 'none';
        }
      } catch {}
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.className = 'auth-alert';
      alertBox.textContent = '';

      const email = emailInput.value.trim();
      const password = document.getElementById('signin-password').value.trim();
      const totp_code = totpInput ? totpInput.value.trim() : '';

      submitBtn.disabled = true;
      btnText.textContent = 'Signing in...';

      try {
        const res = await fetch('/api/auth/signin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, totp_code: totp_code || undefined })
        });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Failed to sign in');
        }

        if (data.requires_2fa) {
          totpField.style.display = 'block';
          totpInput.focus();
          alertBox.className = 'auth-alert';
          alertBox.style.display = 'block';
          alertBox.style.background = 'rgba(6, 182, 212, 0.12)';
          alertBox.style.color = '#0e7490';
          alertBox.textContent = data.message || 'Enter your 6-digit 2FA authenticator code.';
          submitBtn.disabled = false;
          btnText.textContent = 'Verify 2FA & Sign In';
          return;
        }

        localStorage.setItem('sb_session', JSON.stringify({
          access_token: data.access_token || '',
          user: data.user
        }));

        alertBox.className = 'auth-alert success';
        alertBox.textContent = 'Signed in! Redirecting to your workspace...';

        setTimeout(() => {
          window.location.href = '/app';
        }, 500);
      } catch (err) {
        alertBox.className = 'auth-alert error';
        alertBox.textContent = err.message || 'Sign in failed';
        submitBtn.disabled = false;
        btnText.textContent = 'Sign In to Workspace';
      }
    });

    const forgotLink = document.getElementById('forgot-password-link');
    const forgotBox = document.getElementById('forgot-box');
    const forgotSendBtn = document.getElementById('forgot-send-btn');
    const resetFields = document.getElementById('reset-fields');
    const resetConfirmBtn = document.getElementById('reset-confirm-btn');

    forgotLink.addEventListener('click', (e) => {
      e.preventDefault();
      forgotBox.style.display = forgotBox.style.display === 'none' ? 'block' : 'none';
      const em = emailInput.value.trim();
      if (em) document.getElementById('forgot-email').value = em;
    });

    // Reset link from email: /signin?reset_token=...  -> open the reset form pre-filled, then drop the token from the URL.
    try {
      const urlToken = new URLSearchParams(window.location.search).get('reset_token');
      if (urlToken) {
        forgotBox.style.display = 'block';
        resetFields.style.display = 'flex';
        document.getElementById('reset-token-input').value = urlToken;
        window.history.replaceState({}, '', window.location.pathname);
      }
    } catch (e) {}

    forgotSendBtn.addEventListener('click', async () => {
      const em = document.getElementById('forgot-email').value.trim();
      if (!em) return;
      try {
        const r = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: em })
        });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Failed');
        resetFields.style.display = 'flex';
        if (d.reset_token) {
          document.getElementById('reset-token-input').value = d.reset_token;
        }
        alertBox.className = 'auth-alert success';
        alertBox.textContent = d.message || 'Reset token ready. Enter your new password below.';
      } catch (err) {
        alertBox.className = 'auth-alert error';
        alertBox.textContent = err.message || 'Reset request failed';
      }
    });

    resetConfirmBtn.addEventListener('click', async () => {
      const token = document.getElementById('reset-token-input').value.trim();
      const new_password = document.getElementById('reset-pass-input').value.trim();
      try {
        const r = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, new_password })
        });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Reset failed');
        alertBox.className = 'auth-alert success';
        alertBox.textContent = d.message || 'Password updated! Sign in now.';
        forgotBox.style.display = 'none';
      } catch (err) {
        alertBox.className = 'auth-alert error';
        alertBox.textContent = err.message || 'Reset failed';
      }
    });
  </script>
</body>
</html>
