/**
 * Renim AI — Product Homepage (redesign)
 * Fully responsive: phone (<640), tablet (640–1024), laptop/desktop (>1024).
 */
const audience = [
  ['terminal', 'Engineering Leads'], ['category', 'Product Managers'], ['storefront', 'SaaS Founders'],
  ['design_services', 'UI/UX Designers'], ['analytics', 'Growth Analysts'], ['science', 'AI Researchers'],
];
const steps = [
  { n: 1, icon: 'mic', color: '#0e7490', title: 'Capture Everything Effortlessly', desc: 'Record meetings, take quick smart notes, add calendar events, or speak a voice memo on the fly.' },
  { n: 2, icon: 'psychology', color: '#4f46e5', title: 'AI Synthesizes & Connects', desc: 'Renim AI transcribes speech, extracts key decisions, schedules reminders, and builds your morning briefing.' },
  { n: 3, icon: 'rocket_launch', color: '#7c3aed', title: 'Execute with Zero Cognitive Load', desc: 'Check off synced tasks, receive timely meeting alerts, and query your Copilot whenever you need quick answers.' },
];
const nodeIcons = [['forum', '#67e8f9'], ['groups', '#a5b4fc'], ['bug_report', '#93c5fd'], ['code', '#e2e8f0'], ['webhook', '#f9a8d4'], ['key', '#fcd34d']];
const nodes = nodeIcons.map((n, i) => {
  const a = (i / nodeIcons.length) * Math.PI * 2 - Math.PI / 2;
  return { icon: n[0], color: n[1], left: (50 + Math.cos(a) * 41.6).toFixed(2), top: (50 + Math.sin(a) * 41.6).toFixed(2) };
});
const security = [
  { icon: 'shield_lock', title: 'Row Level Security', desc: 'PostgreSQL RLS ensures only your authenticated account can read your notes, meetings and events.' },
  { icon: 'passkey', title: 'Company SSO & 2FA', desc: 'Enforce single sign-on and two-factor authentication across your organization.' },
  { icon: 'manage_accounts', title: 'Roles & Permissions', desc: 'Owner, admin and member roles keep sensitive workspace controls in the right hands.' },
  { icon: 'history', title: 'Audit Trail Export', desc: 'Full activity history with exportable audit logs for compliance reviews.' },
];
const compare = [
  ['All-in-One Daily Architecture', 'Unified SPA Hub', '4-5 Separate Subscriptions'],
  ['Meeting Transcription & Audio Visualizer', 'Built-in Waveform & AI Summary', 'Requires External Bot Services'],
  ['Automated Morning AI Briefing', 'Cross-Module Synthesis', 'Manual Daily Planning'],
  ['Calendar & Proactive Toast Reminders', 'Built-in Background Alerts', 'Requires Third-Party Addons'],
  ['Unified AI Assistant Across Work', 'Meetings, Docs, Tasks & Calendar', 'Disconnected Point Tools'],
];
const plans = [
  { name: 'Starter', m: '0', y: '0', desc: 'Try Renim AI risk-free for your daily notes, tasks, and meeting recaps.', cta: 'Start Free', features: ['500 AI Assistant Credits / mo', 'Up to 3 Team Members', '500 MB Notes & Meeting Vault', 'Smart Notes, Tasks & Calendar Alerts'] },
  { name: 'Pro', m: '199', y: '159', featured: true, desc: 'Save 5+ hours weekly with automated morning briefs and instant follow-ups.', cta: 'Choose Pro', features: ['5,000 AI Assistant Credits / mo', 'Up to 10 Team Members + Role Controls', '5 GB Searchable Company Knowledge', 'Automated Briefs & Meeting Action Items', 'Slack, Microsoft Teams & Webhook Alerts'] },
  { name: 'Team', m: '599', y: '479', desc: 'Keep growing teams & agencies aligned with shared workspaces and audit trails.', cta: 'Choose Team', features: ['25,000 AI Assistant Credits / mo', 'Up to 50 Team Members', '25 GB Shared Document & Meeting Hub', 'Jira, GitHub & Custom Integrations', 'Full Activity History & Audit Export'] },
  { name: 'Enterprise', m: '999', y: '799', desc: 'Enterprise security, unlimited scale, and priority support for organizations.', cta: 'Start Enterprise', features: ['2,50,000+ AI Credits / mo', 'Unlimited Seats + Company SSO & 2FA', '250 GB Encrypted Company Vault', 'Dedicated Account Manager & Onboarding', 'Priority Support & Faster Responses'] },
];
const faqs = [
  ['What makes Renim AI different from normal note or meeting apps?', 'Renim AI is built from the ground up as a unified daily command center. Instead of having your meeting transcripts in one app, your tasks in another, your calendar in a third, and your thoughts in a fourth, Renim AI synchronizes them all together with an AI Copilot that has full context of your entire workday.'],
  ['Do I need to install any Chrome extension to use Renim AI?', 'No! Renim AI is a standalone, web-based Single Page Application (SPA). It uses the browser’s native Web Audio API and Web Speech API for low-latency live microphone recording and soundwave visualization with zero extra downloads required.'],
  ['How does the AI Gateway and model selection work?', 'You have full flexibility! You can configure your own AI Gateway endpoint (such as Cloudflare AI Gateway, OpenAI, or compatible proxies) and choose any model directly from the in-app Settings menu.'],
  ['Is my data private and secure?', 'Yes. All your cloud data is stored in your dedicated database protected by PostgreSQL Row Level Security (RLS). Only your authenticated user ID can read and write your notes, meetings, and calendar events.'],
  ['Do I need an account to use Renim AI?', 'Yes — a free account keeps your notes, meetings and tasks private and synced across your devices. Signing up takes under a minute and no card is required.'],
];
const calDays = Array.from({ length: 21 }, (_, i) => {
  const n = i + 1;
  const kind = n === 9 ? 'today' : n === 4 || n === 15 ? 'deadline' : n === 12 || n === 18 ? 'meeting' : '';
  return { n, kind };
});
const bars = (n: number) => Array.from({ length: n });
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Renim AI — All-in-One Daily AI Productivity Workspace</title>
  <meta name="description" content="Unify your daily workflow with Renim AI. Featuring AI Executive Morning Briefings, Meeting Note-Taking & Transcripts, Smart Second-Brain Notes, Interactive Calendar with Smart Reminders, Tasks, and an AI Workspace Copilot.">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0891b2">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..600,0..1,0" />
  <style is:global>
    :root{--ink:#0f172a;--muted:#475569;--line:#e2e8f0;--bg:#fbfcfd;--cyan:#0891b2;--cyan-t:#0e7490;--indigo:#4f46e5;--violet:#7c3aed;--green:#059669}
    *,*::before,*::after{box-sizing:border-box}
    html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:'Plus Jakarta Sans',system-ui,sans-serif;overflow-x:hidden;-webkit-font-smoothing:antialiased}
    img{max-width:100%;display:block}
    a{color:var(--cyan-t);text-decoration:none}
    section[id]{scroll-margin-top:76px}
    .ms{font-family:'Material Symbols Rounded';font-weight:normal;font-style:normal;font-size:22px;line-height:1;display:inline-block;white-space:nowrap;font-feature-settings:'liga';-webkit-font-feature-settings:'liga';font-variation-settings:'FILL' 0,'wght' 400,'opsz' 24;user-select:none}
    .ms.fill{font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24}
    .wrap{width:100%;max-width:1680px;margin:0 auto;padding:0 clamp(16px,4vw,72px)}
    .sec{padding:88px 0}
    .tag{font-size:12px;font-weight:700;letter-spacing:.14em;color:var(--cyan-t);text-transform:uppercase}
    .h2{margin:0;font-size:clamp(28px,4vw,42px);letter-spacing:-.03em;line-height:1.1}
    .lead{margin:0;color:var(--muted);font-size:17px;line-height:1.6}
    .head{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;max-width:780px;margin:0 auto}
    .card{background:#fff;border:1px solid var(--line);border-radius:20px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:10px 16px;border-radius:12px;font-weight:600;font-size:14px;transition:transform .15s,box-shadow .15s,background .15s}
    .btn:hover{transform:translateY(-1px)}
    .btn-dark{background:var(--ink);color:#fff}
    .btn-line{background:#fff;color:var(--ink);border:1px solid #d5dde5}
    .btn-cyan{background:var(--cyan);color:#fff;box-shadow:0 10px 30px -10px rgba(8,145,178,.6)}
    .btn-lg{padding:15px 24px;font-size:16px;font-weight:700}
    .live{width:8px;height:8px;border-radius:50%;background:#10b981;flex:none;animation:pulse 1.6s ease-out infinite}
    .chip{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:999px;background:#f1f5f9;font-size:13px;font-weight:600;color:#334155}
    .pri{font-size:11px;font-weight:700;padding:2px 7px;border-radius:6px;white-space:nowrap}
    .pri.h{color:#b91c1c;background:#fef2f2}.pri.m{color:#92400e;background:#fffbeb}

    /* animations */
    @keyframes wave{0%,100%{transform:scaleY(.25)}50%{transform:scaleY(1)}}
    .wv{display:flex;align-items:center;gap:4px}
    .wv span{display:block;flex:1 1 0;max-width:4px;min-width:2px;border-radius:4px;background:var(--cyan);height:100%;transform-origin:center;animation:wave 1.1s ease-in-out infinite}
    .wv span:nth-child(3n){animation-delay:-.2s;background:var(--indigo)}
    .wv span:nth-child(3n+1){animation-delay:-.45s}
    .wv span:nth-child(4n){animation-delay:-.7s}
    .wv span:nth-child(5n){animation-delay:-.9s;background:#67a8bb}
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
    .float{animation:float 6s ease-in-out infinite}.float.d2{animation-delay:-2s}.float.d3{animation-delay:-4s}
    @keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
    @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.5)}100%{box-shadow:0 0 0 8px rgba(16,185,129,0)}}
    @keyframes caret{0%,49%{opacity:1}50%,100%{opacity:0}}
    .caret{display:inline-block;width:2px;height:1em;background:var(--cyan-t);vertical-align:-2px;margin-left:2px;animation:caret 1s step-end infinite}
    @keyframes type{from{max-width:0}to{max-width:100%}}
    .typed{overflow:hidden;white-space:nowrap;animation:type 3.2s steps(48) infinite alternate}
    @keyframes check{0%,30%{transform:scale(0);opacity:0}45%{transform:scale(1.2);opacity:1}55%,100%{transform:scale(1);opacity:1}}
    .chk{animation:check 4s ease-out infinite}.chk.d2{animation-delay:1.2s}.chk.d3{animation-delay:2.4s}
    @keyframes toast{0%,10%{transform:translateY(16px);opacity:0}18%,82%{transform:translateY(0);opacity:1}92%,100%{transform:translateY(16px);opacity:0}}
    .toast{animation:toast 7s ease-in-out infinite}
    @keyframes flow{to{stroke-dashoffset:-40}}
    .flow{stroke-dasharray:6 8;animation:flow 1.4s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .orbit{animation:spin 40s linear infinite}.counter{animation:spin 40s linear infinite reverse}
    @keyframes shimmer{0%{background-position:-200px 0}100%{background-position:200px 0}}
    .shim{background:linear-gradient(90deg,#e2e8f0 0,#f1f5f9 50%,#e2e8f0 100%);background-size:400px 100%;animation:shimmer 1.8s linear infinite;height:9px;border-radius:5px}
    @keyframes bubble{0%,15%{opacity:0;transform:translateY(8px)}25%,100%{opacity:1;transform:translateY(0)}}
    .bub{animation:bubble 6s ease-out infinite}.bub.d2{animation-delay:1.4s}
    @keyframes ring{0%,100%{transform:rotate(0)}10%{transform:rotate(14deg)}20%{transform:rotate(-12deg)}30%{transform:rotate(8deg)}40%{transform:rotate(0)}}
    .ring{animation:ring 3s ease-in-out infinite;transform-origin:50% 10%}
    @keyframes kb{0%{transform:scale(1)}100%{transform:scale(1.08)}}
    .kb{animation:kb 14s ease-in-out infinite alternate}
    @media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none !important;transition:none !important}html{scroll-behavior:auto}}

    /* nav */
    .nav{position:sticky;top:0;z-index:50;background:rgba(251,252,253,.88);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid #e9eef3}
    .nav-in{display:flex;align-items:center;justify-content:space-between;gap:16px;height:68px}
    .brand{display:flex;align-items:center;gap:10px;color:var(--ink);font-weight:800;font-size:19px;letter-spacing:-.02em}
    .brand img{width:34px;height:34px;border-radius:10px}
    .brand b{color:var(--cyan-t)}
    .nav-links{display:flex;gap:30px}
    .nav-links a{color:#334155;font-weight:500;font-size:15px}
    .nav-links a:hover{color:var(--ink)}
    .nav-act{display:flex;gap:10px;align-items:center}
    .burger{display:none;width:44px;height:44px;border-radius:10px;border:1px solid #d5dde5;background:#fff;align-items:center;justify-content:center;cursor:pointer;color:var(--ink)}
    .mnav{display:none;border-top:1px solid #e9eef3;background:#fff;padding:12px 24px 20px}
    .mnav a{display:block;padding:12px 4px;font-weight:600;color:var(--ink);border-bottom:1px solid #f1f5f9}
    .mnav .btns{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
    .nav.open .mnav{display:block}

    /* hero */
    .hero{position:relative;padding:80px 0 40px}
    .hbg{position:absolute;inset:0;overflow:hidden;pointer-events:none}
    .aur{position:absolute;left:0;right:0;top:0;height:760px;filter:blur(70px);opacity:.75}
    .blob{position:absolute;border-radius:50%;mix-blend-mode:multiply}
    .b1{width:560px;height:420px;left:8%;top:-80px;background:#a5f3fc;animation:a1 16s ease-in-out infinite}
    .b2{width:520px;height:440px;right:6%;top:-40px;background:#c7d2fe;animation:a2 19s ease-in-out infinite}
    .b3{width:420px;height:360px;left:38%;top:120px;background:#ddd6fe;animation:a3 22s ease-in-out infinite}
    .b4{width:360px;height:300px;left:22%;top:260px;background:#bae6fd;animation:a2 25s ease-in-out infinite reverse}
    @keyframes a1{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(160px,60px) scale(1.15)}66%{transform:translate(60px,-40px) scale(.9)}}
    @keyframes a2{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(-180px,80px) scale(.9)}66%{transform:translate(-60px,-30px) scale(1.12)}}
    @keyframes a3{0%,100%{transform:translate(0,0) rotate(0)}50%{transform:translate(-120px,-60px) rotate(30deg) scale(1.2)}}
    .aur-fade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(251,252,253,0) 0,rgba(251,252,253,.35) 40%,#fbfcfd 78%)}
    @media (max-width:900px){.aur{height:560px;filter:blur(50px)}.b1,.b2{width:340px;height:280px}.b3,.b4{width:260px;height:220px}}
    .dots{position:absolute;inset:0;background-image:radial-gradient(#dbe4ec 1px,transparent 1px);background-size:24px 24px;-webkit-mask-image:radial-gradient(ellipse at 50% 30%,#000 30%,transparent 72%);mask-image:radial-gradient(ellipse at 50% 30%,#000 30%,transparent 72%);pointer-events:none}
    .hero-in{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}
    .pill{display:inline-flex;align-items:center;gap:8px;padding:7px 14px 7px 10px;border-radius:999px;background:#fff;border:1px solid #d9e6ec;color:var(--ink);font-size:13px;font-weight:600}
    .h1{margin:28px 0 0;font-size:clamp(36px,5.4vw,80px);line-height:1.04;letter-spacing:-.035em;font-weight:800;max-width:1100px}
    .h1 span{color:var(--cyan-t)}
    .sub{margin:22px 0 0;max-width:720px;font-size:18px;line-height:1.6;color:var(--muted)}
    .cta-row{margin-top:32px;display:flex;gap:12px;flex-wrap:wrap;justify-content:center}
    .chips{margin-top:28px;display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
    .demo{position:relative;width:100%;max-width:1320px;margin-top:64px;text-align:left}
    .fl{position:absolute;z-index:3;padding:12px 14px;box-shadow:0 20px 40px -20px rgba(15,23,42,.25)}
    .win{background:#fff;border:1px solid #dfe6ed;border-radius:18px;overflow:hidden;box-shadow:0 50px 100px -40px rgba(15,23,42,.35),0 0 0 6px rgba(226,232,240,.5)}
    .win-bar{display:flex;align-items:center;gap:14px;padding:12px 16px;border-bottom:1px solid #edf1f5;background:#f8fafc}
    .url{display:inline-flex;align-items:center;gap:6px;padding:5px 14px;border-radius:8px;background:#fff;border:1px solid var(--line);font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
    .win-body{display:flex;min-height:480px}
    .side{width:230px;flex:none;padding:16px 12px;border-right:1px solid #edf1f5;background:var(--bg);display:flex;flex-direction:column;gap:4px;font-size:14px;font-weight:500;color:var(--muted)}
    .side div{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:9px}
    .side .on{background:#ecfeff;color:var(--cyan-t);font-weight:700}
    .main{flex:1;min-width:0;padding:22px;display:flex;flex-direction:column;gap:16px}
    .brief{padding:18px 20px;border-radius:14px;background:#f0f9fb;border:1px solid #cdeef4}
    .panes{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
    .pane{padding:16px;border-radius:14px;border:1px solid #e8edf2;display:flex;flex-direction:column;gap:12px;min-width:0}
    .row{display:flex;align-items:center;gap:10px;font-size:13px}

    /* marquee */
    .mq{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
    .mq-track{display:flex;gap:14px;width:max-content;animation:marquee 32s linear infinite}
    .mq-track span.it{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:12px;border:1px solid var(--line);background:#fff;white-space:nowrap;font-size:15px;font-weight:600;color:#334155}

    /* mosaic */
    .mos-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}
    .mosaic{margin-top:40px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:260px;gap:16px}
    .ph{position:relative;overflow:hidden;border-radius:22px;background:#e2e8f0}
    .ph img{width:100%;height:100%;object-fit:cover}
    .ph .ov{position:absolute;border-radius:12px;font-size:12px;font-weight:600;display:flex;gap:8px;align-items:center;padding:10px 12px}
    .tall{grid-row:span 2}
    .glass{background:rgba(255,255,255,.95);color:var(--ink);backdrop-filter:blur(8px)}

    /* pipeline */
    .pipe{margin-top:48px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;position:relative}
    .pipe .card{position:relative;z-index:1;padding:22px;display:flex;flex-direction:column;gap:14px}
    .ico{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex:none}
    .pipe-line{position:absolute;left:0;top:50%;width:100%;height:4px;overflow:visible;z-index:0}

    /* bento */
    .bento{margin-top:48px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
    .bc{border-radius:22px;border:1px solid var(--line);background:var(--bg);overflow:hidden;display:flex;flex-direction:column}
    .bv{height:200px;position:relative;overflow:hidden}
    .bt{padding:24px}.bt h3{margin:0;font-size:19px}.bt p{margin:8px 0 0;color:var(--muted);font-size:15px;line-height:1.6}
    .cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px;width:100%;max-width:290px}
    .cal span{height:30px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;background:#fff;color:var(--muted);border:1px solid #fde7b0}
    .cal .today{background:var(--cyan);color:#fff;font-weight:800;border-color:var(--cyan);box-shadow:0 0 0 3px rgba(8,145,178,.25)}
    .cal .deadline{background:#fde68a;color:#78350f;border-color:#fde68a}
    .cal .meeting{background:#ede9fe;color:#5b21b6;border-color:#ede9fe}
    .tk{display:flex;align-items:center;gap:10px;background:#fff;border-radius:10px;padding:10px 12px;font-size:13px;border:1px solid #d1fae5}

    /* workflow */
    .steps{margin-top:56px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
    .step{display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;padding:8px}
    .step h4{margin:0;font-size:18px}.step p{margin:0;color:var(--muted);font-size:15px;line-height:1.6;max-width:320px}
    .badge{position:relative;width:96px;height:96px}

    /* integrations */
    .dark{background:var(--ink);color:#fff}
    .int{display:flex;align-items:center;gap:56px}
    .int > div{flex:1;min-width:0}
    .orb-wrap{display:flex;justify-content:center}
    .orb{position:relative;width:360px;max-width:100%;aspect-ratio:1}
    .node{position:absolute;width:56px;height:56px;margin:-28px 0 0 -28px}
    .node div{width:56px;height:56px;border-radius:16px;background:#1e293b;border:1px solid #334155;display:flex;align-items:center;justify-content:center}
    .opill{font-size:13px;font-weight:600;padding:7px 12px;border-radius:999px;border:1px solid #334155;color:#e2e8f0}

    /* security */
    .grid4{margin-top:44px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}

    /* table */
    .tbl-box{margin-top:40px;overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:18px;border:1px solid var(--line);background:#fff}
    table{width:100%;min-width:640px;border-collapse:collapse;font-size:14px}
    th,td{padding:16px 20px;text-align:left;border-bottom:1px solid #f1f5f9}
    th{color:var(--muted);font-weight:600;padding-top:18px;padding-bottom:18px}
    .hl{background:#f5feff}
    th.hl{background:#ecfeff;color:var(--cyan-t);font-weight:800}

    /* pricing */
    .toggle{position:relative;width:52px;height:30px;border-radius:999px;border:0;cursor:pointer;padding:0;background:#cbd5e1;transition:background .2s}
    .toggle i{position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:left .2s}
    .toggle[aria-pressed="true"]{background:var(--cyan)}
    .toggle[aria-pressed="true"] i{left:25px}
    .plans{margin-top:44px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;align-items:stretch}
    .plan{position:relative;display:flex;flex-direction:column;gap:14px;padding:28px 24px;border-radius:22px;background:var(--bg);border:1px solid var(--line)}
    .plan .mut{color:var(--muted)}
    .plan .feats{display:flex;flex-direction:column;gap:10px;padding-top:14px;border-top:1px solid #eef2f6;flex:1}
    .plan .feats div{display:flex;gap:8px;font-size:14px;line-height:1.45}
    .plan .feats .ms{font-size:18px;color:var(--cyan-t)}
    .plan.feat{background:var(--ink);color:#fff;border-color:var(--ink);box-shadow:0 30px 60px -30px rgba(15,23,42,.6)}
    .plan.feat .mut{color:#cbd5e1}.plan.feat .feats{border-color:#334155}.plan.feat .feats .ms{color:#67e8f9}
    .plan .go{display:flex;justify-content:center;align-items:center;min-height:46px;border-radius:12px;font-weight:700;font-size:15px;background:#fff;color:var(--ink);border:1px solid #d5dde5}
    .plan.feat .go{background:#22d3ee;border-color:#22d3ee}
    .pop{position:absolute;top:-12px;left:24px;font-size:11px;font-weight:800;letter-spacing:.08em;background:var(--cyan);color:#fff;padding:5px 10px;border-radius:999px}

    /* faq */
    .faq{border:1px solid var(--line);border-radius:16px;background:#fff;overflow:hidden}
    .faq button{width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 22px;background:none;border:0;cursor:pointer;font-family:inherit;font-size:16px;font-weight:700;color:var(--ink);text-align:left;min-height:44px}
    .faq button .ms{color:#64748b;transition:transform .2s;flex:none}
    .faq p{margin:0;padding:0 22px 22px;color:var(--muted);font-size:15px;line-height:1.65;display:none}
    .faq.open p{display:block}.faq.open button .ms{transform:rotate(180deg)}

    /* cta */
    .cta{border-radius:28px;background:var(--ink);color:#fff;padding:56px;display:flex;align-items:center;gap:40px;overflow:hidden;position:relative}
    .cta > div{position:relative;flex:1;min-width:0}

    /* footer */
    .foot{border-top:1px solid var(--line);background:#fff;padding:56px 0 28px}
    .foot-top{display:flex;gap:48px;flex-wrap:wrap;justify-content:space-between}
    .foot-cols{display:grid;grid-template-columns:repeat(3,minmax(130px,1fr));gap:32px;font-size:14px}
    .foot-cols div{display:flex;flex-direction:column;gap:10px}
    .foot-cols a{color:var(--muted)}.foot-cols a:hover{color:var(--ink)}
    .foot-bot{margin-top:40px;padding-top:20px;border-top:1px solid #eef2f6;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:13px;color:var(--muted)}

    /* ===== Laptop (≤1180) ===== */
    @media (max-width:1180px){
      .fl.l{left:-12px !important}.fl.r{right:-12px !important}
      .plans{grid-template-columns:repeat(2,minmax(0,1fr))}
    }
    /* ===== Tablet (≤1024) ===== */
    @media (max-width:1024px){
      .sec{padding:72px 0}
      .nav-links{display:none}
      .burger{display:inline-flex}
      .nav-act .btn{display:none}
      .fl{display:none}
      .side{width:180px}
      .bento{grid-template-columns:repeat(2,minmax(0,1fr))}
      .grid4{grid-template-columns:repeat(2,minmax(0,1fr))}
      .mosaic{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:240px}
      .int{flex-direction:column;gap:40px}
      .cta{flex-direction:column;align-items:stretch;padding:44px}
      .cta .ph{height:300px !important}
    }
    /* ===== Small tablet / large phone (≤760) ===== */
    @media (max-width:760px){
      .hero{padding:56px 0 24px}
      .demo{margin-top:44px}
      .side{display:none}
      .sync{display:none !important}
      .main{padding:16px}
      .pipe,.steps{grid-template-columns:1fr}
      .pipe-line{display:none}
      .bento{grid-template-columns:1fr}
      .plans{grid-template-columns:1fr;max-width:460px;margin-left:auto;margin-right:auto}
      .mosaic{grid-template-columns:1fr;grid-auto-rows:220px}
      .tall{grid-row:span 1;min-height:300px}
      .foot-cols{grid-template-columns:repeat(2,minmax(0,1fr))}
    }
    /* ===== Phone (≤520) ===== */
    @media (max-width:520px){
      .wrap{padding:0 16px}
      .sec{padding:56px 0}
      .sub{font-size:16px}
      .cta-row{flex-direction:column;width:100%}
      .cta-row .btn{width:100%}
