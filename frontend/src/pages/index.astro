<script is:inline>
  (function () {
    var nav = document.getElementById('nav');
    var burger = document.getElementById('burger');
    if (burger && nav) {
      burger.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger.querySelector('.ms').textContent = open ? 'close' : 'menu';
      });
      nav.querySelectorAll('.mnav a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav.classList.remove('open');
          burger.setAttribute('aria-expanded', 'false');
          burger.querySelector('.ms').textContent = 'menu';
        });
      });
    }

    var t = document.getElementById('billing-toggle');
    var lm = document.getElementById('lbl-m'), ly = document.getElementById('lbl-y');
    if (t) {
      t.addEventListener('click', function () {
        var yearly = t.getAttribute('aria-pressed') !== 'true';
        t.setAttribute('aria-pressed', yearly ? 'true' : 'false');
        document.querySelectorAll('.price').forEach(function (el) { el.textContent = yearly ? el.dataset.y : el.dataset.m; });
        lm.style.color = yearly ? '#64748b' : '#0f172a';
        ly.style.color = yearly ? '#0f172a' : '#64748b';
      });
    }

    var items = document.querySelectorAll('.faq');
    items.forEach(function (item) {
      var btn = item.querySelector('button');
      btn.addEventListener('click', function () {
        var wasOpen = item.classList.contains('open');
        items.forEach(function (o) { o.classList.remove('open'); o.querySelector('button').setAttribute('aria-expanded', 'false'); });
        if (!wasOpen) { item.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
      });
    });
  })();
</script>
