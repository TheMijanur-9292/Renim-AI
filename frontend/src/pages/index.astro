---
/**
 * Renim AI — Light Mode SaaS Product Homepage (Astro Static Page)
 * 100% Pixel-Identical Design & Interactivity
 */
---
<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Renim AI — All-in-One Daily AI Productivity Workspace</title>
  <meta name="description" content="Unify your daily workflow with Renim AI. Featuring AI Executive Morning Briefings, Meeting Note-Taking & Transcripts, Smart Second-Brain Notes, Interactive Calendar with Smart Reminders, Tasks, and an AI Workspace Copilot.">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0891b2">
  
  <!-- Fonts & Material Symbols (Zero Keyboard Emojis) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Background Ambient Glows -->
  <div class="ambient-glow glow-top"></div>
  <div class="ambient-glow glow-bottom"></div>

  <!-- ================= TOP NAVIGATION ================= -->
  <header class="navbar">
    <div class="container nav-content">
      <a href="#" class="brand">
        <div class="brand-icon">
          <img src="/icon.svg" alt="Renim AI" />
        </div>
        <span class="brand-text">Renim <span class="gradient-text">AI</span></span>
      </a>

      <nav class="nav-links">
        <a href="#features">Features</a>
        <a href="#how-it-works">Workflow</a>
        <a href="#demo">Live Demo</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
      </nav>

      <div class="nav-actions">
        <a href="/signin" class="btn btn-secondary btn-sm">
          <span>Sign In</span>
        </a>
        <a href="/signup" class="btn btn-primary btn-sm">
          <span>Get Started Free</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ================= HERO SECTION ================= -->
  <section class="hero-section">
    <div class="container hero-container">
      
      <!-- Announcement Pill -->
      <div class="hero-badge">
        <span class="material-symbols-rounded icon-sm text-cyan">verified_user</span>
        <span>SOC 2 Ready • Built for High-Velocity Teams</span>
        <span class="badge-arrow">→</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        Turn meetings, notes, and docs <br class="desktop-only" />
        <span class="gradient-text">into one calm workspace.</span>
      </h1>

      <!-- Subheadline -->
      <p class="hero-subtitle">
        Replace 5 fragmented tools with Renim AI. Seamlessly orchestrate AI Morning Briefings, In-Browser Meeting Notes & Live Transcriptions, Smart Second-Brain Notes, Interactive Calendar with Smart Reminders, and Actionable Tasks.
      </p>

      <!-- Hero CTAs -->
      <div class="hero-cta-group">
        <a href="/signup" class="btn btn-primary btn-lg btn-glow">
          <span class="material-symbols-rounded">rocket_launch</span>
          <span>Sign Up & Launch Workspace</span>
        </a>
        <a href="/signin" class="btn btn-secondary btn-lg">
          <span class="material-symbols-rounded">login</span>
          <span>Sign In to Account</span>
        </a>
      </div>

      <!-- Trust Badges Strip -->
      <div class="hero-social-proof">
        <div class="proof-badges">
          <div class="proof-pill">
            <span class="material-symbols-rounded text-cyan">bolt</span>
            <span>Zero-Latency Speech Engine</span>
          </div>
          <div class="proof-pill">
            <span class="material-symbols-rounded text-indigo">cloud_done</span>
            <span>Supabase Cloud Sync & RLS</span>
          </div>
          <div class="proof-pill">
            <span class="material-symbols-rounded text-purple">hub</span>
            <span>BYO AI Gateway & Models</span>
          </div>
        </div>
      </div>

      <!-- ================= PRODUCT SHOWCASE / MOCKUP ================= -->
      <div id="demo" class="product-showcase-wrapper">
        <div class="mockup-window">
          <div class="mockup-header">
            <div class="window-controls">
              <span class="control-dot dot-red"></span>
              <span class="control-dot dot-yellow"></span>
              <span class="control-dot dot-green"></span>
            </div>
            <div class="window-url">
              <span class="material-symbols-rounded icon-xs">lock</span>
              <span>app.renimai.com/workspace</span>
            </div>
            <div class="window-badge">
              <span class="status-live-dot"></span>
              <span>CLOUD SYNC ACTIVE</span>
            </div>
          </div>

          <div class="mockup-body workspace-demo-layout">
            
            <!-- Demo Sidebar -->
            <div class="demo-sidebar">
              <div class="demo-nav-item active">
                <span class="material-symbols-rounded">wb_sunny</span>
                <span>Today</span>
              </div>
              <div class="demo-nav-item">
                <span class="material-symbols-rounded">mic</span>
                <span>Meetings Hub</span>
              </div>
              <div class="demo-nav-item">
                <span class="material-symbols-rounded">edit_note</span>
                <span>Smart Notes</span>
              </div>
              <div class="demo-nav-item">
                <span class="material-symbols-rounded">calendar_month</span>
                <span>Calendar & Alerts</span>
              </div>
              <div class="demo-nav-item">
                <span class="material-symbols-rounded">task_alt</span>
                <span>Tasks & To-Do</span>
              </div>
              <div class="demo-nav-item">
                <span class="material-symbols-rounded">smart_toy</span>
                <span>Ask Copilot</span>
              </div>
            </div>

            <!-- Demo Main Content -->
            <div class="demo-content-area">
              
              <!-- Morning Briefing Card -->
              <div class="demo-briefing-card">
                <div class="demo-card-title">
                  <span class="material-symbols-rounded text-cyan">auto_awesome</span>
                  <strong>AI Executive Morning Briefing</strong>
                </div>
                <p class="demo-briefing-text">
                  Good morning! Today you have <strong>2 High-Priority Tasks</strong> and an upcoming <strong>Product Architecture Review at 2:00 PM</strong>. Your focus today is deploying the database RLS policies.
                </p>
              </div>

              <!-- Dual Grid: Meeting Live Transcriber & Action Tasks -->
              <div class="demo-split-grid">
                
                <!-- Left: Live Meeting Card -->
                <div class="demo-panel-card">
                  <div class="demo-panel-header">
                    <div class="flex-align-gap">
                      <span class="material-symbols-rounded text-indigo">mic</span>
                      <strong>Sprint 14 Sync & Architecture</strong>
                    </div>
                    <span class="badge-tag">Live Recording</span>
                  </div>
                  
                  <div class="demo-waveform">
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                  </div>

                  <div class="demo-transcript-box">
                    <div class="demo-transcript-line">
                      <span class="speaker-tag">Alex Johnson:</span>
                      <span>"Let's finalize the Supabase table permissions and deploy the AI gateway model."</span>
                    </div>
                  </div>

                  <div class="demo-ai-summary-pill">
                    <span class="material-symbols-rounded icon-xs text-cyan">lightbulb</span>
                    <span><strong>Key Decision:</strong> Launch Pro Tier with custom gateway endpoints.</span>
                  </div>
                </div>

                <!-- Right: Action Tasks & Calendar -->
                <div class="demo-panel-card">
                  <div class="demo-panel-header">
                    <div class="flex-align-gap">
                      <span class="material-symbols-rounded text-purple">task_alt</span>
                      <strong>Today's Priority Tasks</strong>
                    </div>
                    <span class="badge-tag">3 Pending</span>
                  </div>

                  <div class="demo-task-list">
                    <div class="demo-task-item done">
                      <span class="material-symbols-rounded check-icon">check_circle</span>
                      <span class="task-title">Run supabase-schema.sql in editor</span>
                      <span class="priority-badge high">High</span>
                    </div>
                    <div class="demo-task-item">
                      <span class="material-symbols-rounded check-icon">radio_button_unchecked</span>
                      <span class="task-title">Review Sprint 14 AI summary & decisions</span>
                      <span class="priority-badge high">High</span>
                    </div>
                    <div class="demo-task-item">
                      <span class="material-symbols-rounded check-icon">radio_button_unchecked</span>
                      <span class="task-title">Schedule client demonstration on calendar</span>
                      <span class="priority-badge med">Medium</span>
                    </div>
                  </div>

                  <div class="demo-reminder-alert">
                    <span class="material-symbols-rounded icon-xs text-amber">alarm</span>
                    <span>Reminder in 15 mins: <strong>Sprint Architecture Review</strong></span>
                  </div>
                </div>

              </div>

            </div>

          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ================= TRUST MARQUEE ================= -->
  <section class="trust-section">
    <div class="container text-center">
      <p class="trust-caption">POWERS DAILY WORKFLOWS FOR HIGH-VELOCITY OPERATORS & TEAMS</p>
      <div class="logo-marquee">
        <span class="logo-pill"><span class="material-symbols-rounded">terminal</span> Engineering Leads</span>
        <span class="logo-pill"><span class="material-symbols-rounded">category</span> Product Managers</span>
        <span class="logo-pill"><span class="material-symbols-rounded">storefront</span> SaaS Founders</span>
        <span class="logo-pill"><span class="material-symbols-rounded">design_services</span> UI/UX Designers</span>
        <span class="logo-pill"><span class="material-symbols-rounded">analytics</span> Growth Analysts</span>
        <span class="logo-pill"><span class="material-symbols-rounded">science</span> AI Researchers</span>
      </div>
    </div>
  </section>

  <!-- ================= BENTO GRID CORE CAPABILITIES ================= -->
  <section id="features" class="features-section">
    <div class="container">
      
      <div class="section-header text-center">
        <span class="section-tag">POWERFUL WORKSPACE SUITE</span>
        <h2 class="section-title">Engineered to Supercharge Your Daily Routine</h2>
        <p class="section-subtitle">Every tool you need to plan, capture, summarize, and execute your workday with zero cognitive overload.</p>
      </div>

      <div class="bento-grid">
        
        <!-- Feature 1: Large Bento Card -->
        <div class="bento-card bento-span-2">
          <div class="bento-icon-box">
            <span class="material-symbols-rounded text-cyan">wb_sunny</span>
          </div>
          <h3 class="bento-title">AI Executive Morning Briefing</h3>
          <p class="bento-desc">Wake up to an intelligent digest of your daily agenda, high-impact tasks, pending deadlines, and previous meeting takeaways synthesized into one crisp summary.</p>
          <div class="bento-visual visual-briefing">
            <div class="briefing-chip">
              <span class="material-symbols-rounded icon-sm text-cyan">summarize</span>
              <span>"Today's highest leverage task is deploying the production database."</span>
            </div>
          </div>
        </div>

        <!-- Feature 2: Large Bento Card -->
        <div class="bento-card bento-span-2">
          <div class="bento-icon-box">
            <span class="material-symbols-rounded text-indigo">mic</span>
          </div>
          <h3 class="bento-title">Meetings Hub & Live Waveform Transcriber</h3>
          <p class="bento-desc">Record meetings directly from your browser with real-time audio visualization, automatic speech-to-text, executive summaries, decisions, and action items.</p>
          <div class="bento-visual visual-dialogue">
            <div class="sample-tag"><span class="material-symbols-rounded icon-xs">check_circle</span> Auto-Extracted Action Items with Deadlines</div>
            <div class="sample-tag sample-tag-2"><span class="material-symbols-rounded icon-xs">lightbulb</span> Key Takeaways & Executive Decisions</div>
          </div>
        </div>

        <!-- Feature 3: Smart Notes (Second Brain) -->
        <div class="bento-card">
          <div class="bento-icon-box">
            <span class="material-symbols-rounded text-purple">edit_note</span>
          </div>
          <h3 class="bento-title">Smart Notes & AI Assistant</h3>
          <p class="bento-desc">Capture rich thoughts with tag filtering and trigger 1-click AI commands: summarize, fix grammar, rewrite professionally, or brainstorm next steps.</p>
        </div>

        <!-- Feature 4: Interactive Calendar & Reminders -->
        <div class="bento-card">
          <div class="bento-icon-box">
            <span class="material-symbols-rounded text-amber">calendar_month</span>
          </div>
          <h3 class="bento-title">Interactive Calendar & Alerts</h3>
          <p class="bento-desc">Schedule Work, Meeting, Deadline, and Personal events with automated background reminder monitors that alert you before critical calls.</p>
        </div>

        <!-- Feature 5: Tasks & Action Items Management -->
        <div class="bento-card">
          <div class="bento-icon-box">
            <span class="material-symbols-rounded text-emerald">task_alt</span>
          </div>
          <h3 class="bento-title">Action Items & Priority Engine</h3>
          <p class="bento-desc">Manage your to-dos with High, Medium, and Low priorities. Sync action items directly from meeting summaries with zero copy-pasting.</p>
        </div>

        <!-- Feature 6: Workspace AI Copilot -->
        <div class="bento-card">
          <div class="bento-icon-box">
            <span class="material-symbols-rounded text-cyan">smart_toy</span>
          </div>
          <h3 class="bento-title">Context-Aware AI Copilot</h3>
          <p class="bento-desc">Ask your AI Copilot anything about your workspace: past meetings, draft notes, task statuses, or upcoming calendar schedules in natural language.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ================= HOW IT WORKS WORKFLOW ================= -->
  <section id="how-it-works" class="workflow-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">FRICTIONLESS WORKFLOW</span>
        <h2 class="section-title">How Renim AI Powers Your Daily Execution</h2>
        <p class="section-subtitle">A seamless 3-step loop designed to keep you organized and focused all day long.</p>
      </div>

      <div class="workflow-grid">
        <div class="workflow-step">
          <div class="step-badge">1</div>
          <div class="step-icon-wrap">
            <span class="material-symbols-rounded text-cyan">mic</span>
          </div>
          <h4 class="step-title">Capture Everything Effortlessly</h4>
          <p class="step-desc">Record meetings, take quick smart notes, add calendar events, or speak a voice memo on the fly.</p>
        </div>

        <div class="workflow-step">
          <div class="step-badge">2</div>
          <div class="step-icon-wrap">
            <span class="material-symbols-rounded text-indigo">psychology</span>
          </div>
          <h4 class="step-title">AI Synthesizes & Connects</h4>
          <p class="step-desc">Renim AI transcribes speech, extracts key decisions, schedules reminders, and builds your morning briefing.</p>
        </div>

        <div class="workflow-step">
          <div class="step-badge">3</div>
          <div class="step-icon-wrap">
            <span class="material-symbols-rounded text-purple">rocket_launch</span>
          </div>
          <h4 class="step-title">Execute with Zero Cognitive Load</h4>
          <p class="step-desc">Check off synced tasks, receive timely meeting alerts, and query your Copilot whenever you need quick answers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= COMPARISON SECTION ================= -->
  <section class="comparison-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">UNIFIED EFFICIENCY</span>
        <h2 class="section-title">Why Switch from Disjointed Tools to Renim AI</h2>
      </div>

      <div class="comparison-table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Capabilities</th>
              <th class="col-highlight">Renim AI Workspace</th>
              <th>Fragmented App Stack (Notion + Otter + Motion)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>All-in-One Daily Architecture</strong></td>
              <td class="col-highlight"><span class="material-symbols-rounded check-green">check_circle</span> Unified SPA Hub</td>
              <td><span class="material-symbols-rounded cross-red">cancel</span> 4-5 Separate Subscriptions</td>
            </tr>
            <tr>
              <td><strong>Meeting Transcription & Audio Visualizer</strong></td>
              <td class="col-highlight"><span class="material-symbols-rounded check-green">check_circle</span> Built-in Waveform & AI Summary</td>
              <td><span class="material-symbols-rounded cross-red">cancel</span> Requires External Bot Services</td>
            </tr>
            <tr>
              <td><strong>Automated Morning AI Briefing</strong></td>
              <td class="col-highlight"><span class="material-symbols-rounded check-green">check_circle</span> Cross-Module Synthesis</td>
              <td><span class="material-symbols-rounded cross-red">cancel</span> Manual Daily Planning</td>
            </tr>
            <tr>
              <td><strong>Calendar & Proactive Toast Reminders</strong></td>
              <td class="col-highlight"><span class="material-symbols-rounded check-green">check_circle</span> Built-in Background Alerts</td>
              <td><span class="material-symbols-rounded cross-red">cancel</span> Requires Third-Party Addons</td>
            </tr>
            <tr>
              <td><strong>Unified AI Assistant Across Work</strong></td>
              <td class="col-highlight"><span class="material-symbols-rounded check-green">check_circle</span> Meetings, Docs, Tasks & Calendar</td>
              <td><span class="material-symbols-rounded cross-red">cancel</span> Disconnected Point Tools</td>
            </tr>
            <tr>
              <td><strong>Cost</strong></td>
              <td class="col-highlight"><span class="badge-price-win">₹199 / month</span></td>
              <td><span>₹4,500+ / month total</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= PRICING SECTION ================= -->
  <section id="pricing" class="pricing-section">
    <div class="container">
      
      <div class="section-header text-center">
        <span class="section-tag">SIMPLE, TRANSPARENT PRICING</span>
        <h2 class="section-title">Built to Scale With Your Business</h2>
        <p class="section-subtitle">Start free in seconds. Upgrade only when your team needs more AI capacity, storage, and controls.</p>

        <!-- Billing Toggle -->
        <div class="billing-toggle-container">
          <span class="billing-label" id="label-monthly">Monthly</span>
          <div class="toggle-switch" id="billing-toggle">
            <div class="toggle-handle"></div>
          </div>
          <span class="billing-label" id="label-yearly">Yearly</span>
          <span class="discount-badge">Save 20%</span>
        </div>
      </div>

      <div class="pricing-grid">
        
        <!-- Tier 1: Starter -->
        <div class="pricing-card">
          <div class="pricing-header">
            <span class="plan-name">Starter</span>
            <div class="plan-price">
              <span class="currency">₹</span>
              <span class="price-val">0</span>
              <span class="period">/ month</span>
            </div>
            <p class="plan-desc">Try Renim AI risk-free for your daily notes, tasks, and meeting recaps.</p>
          </div>

          <div class="plan-features">
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>500 AI Assistant Credits / mo</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>Up to 3 Team Members</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>500 MB Notes & Meeting Vault</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>Smart Notes, Tasks & Calendar Alerts</span>
            </div>
          </div>

          <a href="/signup" class="btn btn-secondary btn-block">Start Free</a>
        </div>

        <!-- Tier 2: Pro (Featured) -->
        <div class="pricing-card card-featured">
          <div class="featured-tag">MOST POPULAR</div>
          <div class="pricing-header">
            <span class="plan-name">Pro</span>
            <div class="plan-price">
              <span class="currency">₹</span>
              <span class="price-val" id="pro-price">199</span>
              <span class="period">/ month</span>
            </div>
            <p class="plan-desc">Save 5+ hours weekly with automated morning briefs and instant follow-ups.</p>
          </div>

          <div class="plan-features">
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span><strong>5,000 AI Assistant Credits / mo</strong></span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>Up to 10 Team Members + Role Controls</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>5 GB Searchable Company Knowledge</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>Automated Briefs & Meeting Action Items</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>Slack, Microsoft Teams & Webhook Alerts</span>
            </div>
          </div>

          <a href="/signup" class="btn btn-primary btn-block">Choose Pro</a>
        </div>

        <!-- Tier 3: Team -->
        <div class="pricing-card">
          <div class="pricing-header">
            <span class="plan-name">Team</span>
            <div class="plan-price">
              <span class="currency">₹</span>
              <span class="price-val" id="team-price">599</span>
              <span class="period">/ month</span>
            </div>
            <p class="plan-desc">Keep growing teams & agencies aligned with shared workspaces and audit trails.</p>
          </div>

          <div class="plan-features">
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span><strong>25,000 AI Assistant Credits / mo</strong></span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>Up to 50 Team Members</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>25 GB Shared Document & Meeting Hub</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>Jira, GitHub & Custom Integrations</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>Full Activity History & Audit Export</span>
            </div>
          </div>

          <a href="/signup" class="btn btn-secondary btn-block">Choose Team</a>
        </div>

        <!-- Tier 4: Enterprise -->
        <div class="pricing-card">
          <div class="pricing-header">
            <span class="plan-name">Enterprise</span>
            <div class="plan-price">
              <span class="currency">₹</span>
              <span class="price-val" id="enterprise-price">999</span>
              <span class="period">/ month</span>
            </div>
            <p class="plan-desc">Enterprise security, unlimited scale, and priority support for organizations.</p>
          </div>

          <div class="plan-features">
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span><strong>2,50,000+ AI Credits / mo</strong></span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>Unlimited Seats + Company SSO & 2FA</span>
            </div>
            <div class="feature-item">
              <span class="material-symbols-rounded icon-sm text-cyan">check</span>
              <span>250 GB Encrypted Company Vault</span>
            </div>
