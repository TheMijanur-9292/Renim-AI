  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const billingToggle = document.getElementById('billing-toggle');
      const proPrice = document.getElementById('pro-price');
      const teamPrice = document.getElementById('team-price');
      const enterprisePrice = document.getElementById('enterprise-price');
      const labelMonthly = document.getElementById('label-monthly');
      const labelYearly = document.getElementById('label-yearly');

      let isAnnual = false;

      if (billingToggle && proPrice && teamPrice && enterprisePrice) {
        billingToggle.addEventListener('click', () => {
          isAnnual = !isAnnual;
          billingToggle.classList.toggle('annual', isAnnual);

          if (isAnnual) {
            proPrice.textContent = '159';
            teamPrice.textContent = '479';
            enterprisePrice.textContent = '799';
            if (labelYearly) labelYearly.style.color = '#0f172a';
            if (labelMonthly) labelMonthly.style.color = '#64748b';
          } else {
            proPrice.textContent = '199';
            teamPrice.textContent = '599';
            enterprisePrice.textContent = '999';
            if (labelMonthly) labelMonthly.style.color = '#0f172a';
            if (labelYearly) labelYearly.style.color = '#64748b';
          }
        });
      }

      const faqItems = document.querySelectorAll('.faq-item');
      faqItems.forEach(item => {
        const questionBtn = item.querySelector('.faq-question');
        if (questionBtn) {
          questionBtn.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            faqItems.forEach(other => other.classList.remove('active'));
            if (!isActive) {
              item.classList.add('active');
            }
          });
        }
      });
    });
  </script>
