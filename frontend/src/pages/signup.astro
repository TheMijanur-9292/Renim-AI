---
import SentryLoader from '../components/SentryLoader.astro';
/**
 * Renim AI — Create account (redesign, matches /signin). Photo panel hides below 960px.
 */
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create your account — Renim AI</title>
  <meta name="description" content="Create your free Renim AI workspace — capture conversations, notes, tasks and reminders in one calm place.">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <meta name="theme-color" content="#0891b2">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..600,0..1,0" />
  <style is:global>
    *,*::before,*::after{box-sizing:border-box}
    [hidden]{display:none !important}
    body{margin:0;background:#fbfcfd;color:#0f172a;font-family:'Plus Jakarta Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:#0e7490;text-decoration:none}a:hover{color:#155e75}
    .ms{font-family:'Material Symbols Rounded';font-weight:normal;font-style:normal;font-size:20px;line-height:1;display:inline-block;white-space:nowrap;font-feature-settings:'liga';-webkit-font-feature-settings:'liga';font-variation-settings:'FILL' 0,'wght' 400,'opsz' 24;user-select:none}
    .ms.fill{font-variation-settings:'FILL' 1,'wght' 400,'opsz' 24}
    .shell{min-height:100vh;min-height:100dvh;display:flex}
    .form-side{position:relative;flex:1 1 560px;min-width:0;display:flex;flex-direction:column;overflow:hidden}
    .aur{position:absolute;left:0;right:0;top:0;height:620px;filter:blur(70px);opacity:.7;pointer-events:none}
    .blob{position:absolute;border-radius:50%;mix-blend-mode:multiply}
    .b1{width:420px;height:340px;left:-60px;top:-100px;background:#a5f3fc;animation:a1 16s ease-in-out infinite}
    .b2{width:380px;height:320px;right:-40px;top:-40px;background:#c7d2fe;animation:a2 19s ease-in-out infinite}
    .b3{width:320px;height:260px;left:30%;top:160px;background:#ddd6fe;animation:a1 23s ease-in-out infinite reverse}
    @keyframes a1{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(120px,50px) scale(1.15)}66%{transform:translate(40px,-30px) scale(.9)}}
    @keyframes a2{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(-140px,60px) scale(.9)}66%{transform:translate(-40px,-20px) scale(1.12)}}
    .fade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(251,252,253,0),rgba(251,252,253,.4) 40%,#fbfcfd 80%);pointer-events:none}
    .top{position:relative;display:flex;justify-content:space-between;align-items:center;padding:24px clamp(16px,5vw,56px);gap:12px}
    .brand{display:flex;align-items:center;gap:10px;color:#0f172a;font-weight:800;font-size:19px;letter-spacing:-.02em}
    .brand img{width:34px;height:34px;border-radius:10px}
    .brand b{color:#0e7490}
    .home{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:600;color:#475569;min-height:44px}
    .center{position:relative;flex:1;display:flex;align-items:center;justify-content:center;padding:16px clamp(16px,5vw,56px) 48px}
    .box{width:100%;max-width:420px}
    .h{margin:0;font-size:clamp(28px,3.4vw,36px);letter-spacing:-.03em;line-height:1.1}
    .p{margin:8px 0 28px;color:#475569;font-size:16px;line-height:1.55}
    form{display:flex;flex-direction:column;gap:18px}
    .field{display:flex;flex-direction:column;gap:8px}
    .field label{font-size:14px;font-weight:600}
    .hint{font-size:13px;color:#64748b}
    .iw{position:relative}
    .iw > .ms{position:absolute;left:14px;top:14px;color:#64748b;pointer-events:none}
    .inp{width:100%;height:48px;border-radius:12px;border:1px solid #d5dde5;background:#fff;padding:0 14px 0 42px;font-family:inherit;font-size:16px;color:#0f172a;outline:none;transition:border-color .15s,box-shadow .15s}
    .inp:focus{border-color:#0891b2;box-shadow:0 0 0 4px rgba(8,145,178,.15)}
    .inp::placeholder{color:#94a3b8}
    .eye{position:absolute;right:2px;top:2px;width:44px;height:44px;border:0;background:none;cursor:pointer;color:#64748b;display:flex;align-items:center;justify-content:center;border-radius:10px}
    .btn-main{width:100%;height:50px;border:0;border-radius:12px;background:#0f172a;color:#fff;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:background .15s,opacity .15s}
    .btn-main:hover{background:#1e293b}.btn-main:disabled{opacity:.6;cursor:wait}
    .alert{display:none;margin-bottom:18px;padding:12px 14px;border-radius:12px;font-size:14px;line-height:1.5}
    .alert.show{display:flex;gap:8px;align-items:flex-start}
    .alert.error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
    .alert.success{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
    .perks{display:flex;flex-wrap:wrap;gap:8px 16px;margin:-8px 0 26px;font-size:13px;color:#334155;font-weight:600}
    .perks span{display:inline-flex;align-items:center;gap:6px}
    .perks .ms{font-size:18px;color:#059669}
    .note{margin-top:36px;padding-top:20px;border-top:1px solid #e9eef3;display:flex;gap:10px;align-items:flex-start;font-size:13px;color:#64748b;line-height:1.5}
    .photo{position:relative;flex:1 1 560px;min-width:0;margin:16px;border-radius:28px;overflow:hidden;background:#0f172a;min-height:640px}
    .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    @keyframes kb{0%{transform:scale(1)}100%{transform:scale(1.08)}}
    .kb{animation:kb 16s ease-in-out infinite alternate}
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    .float{animation:float 6s ease-in-out infinite}.d2{animation-delay:-2s}
    @keyframes cycle{0%{opacity:0;transform:translateY(8px)}4%,20%{opacity:1;transform:translateY(0)}24%,100%{opacity:0;transform:translateY(-8px)}}
    .uc{position:absolute;left:0;top:0;opacity:0;animation:cycle 15s ease-in-out infinite;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:rgba(255,255,255,.14);color:#fff;font-weight:600}
    .uc .ms{font-size:16px;color:#67e8f9}
    .u2{animation-delay:3s}.u3{animation-delay:6s}.u4{animation-delay:9s}.u5{animation-delay:12s}
    @keyframes check{0%,30%{transform:scale(0);opacity:0}45%{transform:scale(1.2);opacity:1}55%,100%{transform:scale(1);opacity:1}}
    .chk{animation:check 4s ease-out infinite}.chk.c2{animation-delay:1.2s}.chk.c3{animation-delay:2.4s}
    .steps{position:absolute;right:36px;top:40px;width:300px;max-width:calc(100% - 72px);background:rgba(255,255,255,.96);border-radius:18px;padding:18px;box-shadow:0 30px 60px -24px rgba(15,23,42,.45);display:flex;flex-direction:column;gap:12px}
    .steps .r{display:flex;align-items:center;gap:10px;font-size:13px;color:#334155}
    .steps .r .ms{color:#059669;font-size:20px}
    @media (max-width:960px){.photo{display:none}}
    @media (max-width:520px){.top{padding:16px}.p{font-size:15px}}
    @media (prefers-reduced-motion:reduce){*{animation:none !important}.u1{opacity:1}}
  </style>
  <SentryLoader />
</head>
<body>
<div class="shell">
  <main class="form-side">
    <div class="aur" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span></div>
    <div class="fade" aria-hidden="true"></div>

    <div class="top">
      <a href="/" class="brand"><img src="/icon.svg" alt="" width="34" height="34" /><span>Renim <b>AI</b></span></a>
      <a href="/" class="home"><span class="ms" style="font-size:18px" aria-hidden="true">arrow_back</span>Home</a>
    </div>

    <div class="center">
      <div class="box">
        <h1 class="h">Create your workspace</h1>
        <p class="p">Bring your conversations, notes, tasks and reminders into one calm place — whatever kind of work you do.</p>
        <div class="perks">
          <span><span class="ms fill" aria-hidden="true">check_circle</span>Free to start</span>
          <span><span class="ms fill" aria-hidden="true">check_circle</span>No card required</span>
          <span><span class="ms fill" aria-hidden="true">check_circle</span>Ready in a minute</span>
        </div>

        <div id="signup-alert" class="alert" role="status" aria-live="polite"></div>

        <form id="signup-form" novalidate>
          <div class="field">
            <label for="signup-name">Full name</label>
            <div class="iw"><span class="ms" aria-hidden="true">person</span><input type="text" id="signup-name" class="inp" placeholder="Your name" autocomplete="name" required /></div>
          </div>
          <div class="field">
            <label for="signup-email">Email</label>
            <div class="iw"><span class="ms" aria-hidden="true">mail</span><input type="email" id="signup-email" class="inp" placeholder="name@example.com" autocomplete="email" required /></div>
          </div>
          <div class="field">
            <label for="signup-password">Password</label>
            <div class="iw"><span class="ms" aria-hidden="true">lock</span><input type="password" id="signup-password" class="inp" placeholder="Create a password" autocomplete="new-password" style="padding-right:52px" required /><button type="button" class="eye" id="eye" aria-label="Show password"><span class="ms" aria-hidden="true">visibility</span></button></div>
            <span class="hint">At least 8 characters, with letters and numbers.</span>
          </div>
          <button type="submit" id="signup-btn" class="btn-main"><span id="signup-btn-text">Create account</span><span class="ms" aria-hidden="true">arrow_forward</span></button>
        </form>
        <p style="margin:24px 0 0;text-align:center;font-size:14px;color:#475569">Already have an account? <a href="/signin" style="font-weight:700">Sign in</a></p>
        <p style="margin:12px 0 0;text-align:center;font-size:13px;color:#64748b;line-height:1.5">By creating an account you agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>

        <div class="note">
          <span class="ms" style="font-size:18px;color:#0e7490" aria-hidden="true">shield_lock</span>
          <span>Your workspace is private to you. Invite teammates only when you're ready.</span>
        </div>
      </div>
    </div>
  </main>

  <aside class="photo" aria-hidden="true">
    <img class="kb" src="/images/team-standup.jpg" alt="" />
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,23,42,.1) 0%,rgba(15,23,42,.2) 45%,rgba(15,23,42,.85) 100%)"></div>
    <div class="float d2" style="position:absolute;left:36px;top:48%;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:14px;background:rgba(15,23,42,.9);color:#fff;font-size:13px;box-shadow:0 20px 40px -16px rgba(0,0,0,.5)"><span class="ms fill" style="font-size:18px;color:#fbbf24">notifications_active</span>Reminder set for tomorrow, 9:00</div>
    <div style="position:absolute;left:0;right:0;bottom:0;padding:40px;color:#fff;display:flex;flex-direction:column;gap:14px">
      <h2 style="margin:0;font-size:clamp(24px,2.4vw,32px);letter-spacing:-.02em;line-height:1.2;max-width:520px">Spend less time remembering, more time doing the work that matters.</h2>
      <div style="display:flex;align-items:center;gap:10px;font-size:15px;color:#cbd5e1;flex-wrap:wrap">
        <span>Used for</span>
        <span style="position:relative;display:inline-block;height:28px;min-width:220px">
          <span class="uc u1"><span class="ms">call</span>client calls</span>
          <span class="uc u2"><span class="ms">groups</span>team meetings</span>
          <span class="uc u3"><span class="ms">school</span>lectures &amp; classes</span>
          <span class="uc u4"><span class="ms">badge</span>interviews</span>
          <span class="uc u5"><span class="ms">handshake</span>consultations</span>
        </span>
      </div>
    </div>
  </aside>
</div>

<script is:inline>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var alertBox = $('signup-alert');
    var submitBtn = $('signup-btn'), btnText = $('signup-btn-text');

    function setAlert(kind, msg) {
      alertBox.className = 'alert show ' + kind;
      alertBox.innerHTML = '';
      var i = document.createElement('span'); i.className = 'ms'; i.style.fontSize = '18px'; i.textContent = kind === 'error' ? 'error' : 'check_circle';
      var t = document.createElement('span'); t.textContent = msg;
      alertBox.appendChild(i); alertBox.appendChild(t);
    }

    $('eye').addEventListener('click', function () {
      var inp = $('signup-password'), b = $('eye');
      var showing = inp.type === 'text';
      inp.type = showing ? 'password' : 'text';
      b.querySelector('.ms').textContent = showing ? 'visibility' : 'visibility_off';
      b.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
    });

    $('signup-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      alertBox.className = 'alert';
      var full_name = $('signup-name').value.trim();
      var email = $('signup-email').value.trim();
      var password = $('signup-password').value.trim();
      if (!full_name || !email || !password) { setAlert('error', 'Fill in your name, email and a password to continue.'); return; }

      submitBtn.disabled = true; btnText.textContent = 'Creating your workspace…';
      try {
        var res = await fetch('/api/auth/signup', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, password: password, full_name: full_name })
        });
        var data = await res.json();
        if (!res.ok) throw new Error(data.error || 'We couldn’t create your account. Please try again.');
        localStorage.setItem('sb_session', JSON.stringify({ access_token: data.access_token || 'neon-session-token', user: data.user }));
        setAlert('success', 'Account created. Opening your workspace…');
        setTimeout(function () { window.location.href = '/app'; }, 500);
      } catch (err) {
        setAlert('error', err.message || 'Sign up failed. Please try again.');
        submitBtn.disabled = false; btnText.textContent = 'Create account';
      }
    });
  })();
</script>
</body>
</html>
